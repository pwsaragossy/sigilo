# deps / build (scoped so the vendored SDK below is not swallowed)
node_modules/
/target/
/app/dist/
/web/dist/

# env & secrets — demo keys are seed-generated and disposable, never committed
.env
.env.*
*.key
*.secret

# local state
.DS_Store
*.log
.demo-state/

# app build output and deps
/app/node_modules/
/app/vendor/
